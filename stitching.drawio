        <mxCell id="xjI4yYPpASLzUZVEaji--85" value="实线代表确定性的奖励值，虚线代表奖励可能会有随机性&lt;div style=&quot;font-size: 30px;&quot;&gt;&lt;br style=&quot;font-size: 30px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 30px;&quot;&gt;黄色表示一种动作（较优），获得1的奖励&lt;/div&gt;&lt;div style=&quot;font-size: 30px;&quot;&gt;黑色表示另一种动作，获得-1的奖励&lt;/div&gt;&lt;div style=&quot;font-size: 30px;&quot;&gt;&lt;br style=&quot;font-size: 30px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 30px;&quot;&gt;进入最终状态时奖励很极端，+100或-100&lt;/div&gt;&lt;div style=&quot;font-size: 30px;&quot;&gt;线的颜色表示动作个数&lt;/div&gt;&lt;div style=&quot;font-size: 30px;&quot;&gt;线的虚实表示随机状态转换，虚线的密集程度表示概率&lt;/div&gt;&lt;div style=&quot;font-size: 30px;&quot;&gt;圈里的数字表示状态&lt;/div&gt;&lt;div style=&quot;font-size: 30px;&quot;&gt;&lt;div style=&quot;font-size: 30px;&quot;&gt;&lt;br style=&quot;font-size: 30px;&quot;&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=30;" vertex="1" parent="1">
          <mxGeometry x="-10" y="-400" width="610" height="310" as="geometry" />
        </mxCell>
